# Copy this file to .env and fill in your real values before running.

# Random long string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on (hosts like Railway/Render set this for you automatically)
PORT=8080

# Twelve Data API key — https://twelvedata.com (free tier is enough to start)
TWELVE_DATA_API_KEY=your-twelve-data-key-here

# Anthropic API key — https://console.anthropic.com -> API Keys -> Create Key
# Leave blank to disable AI commentary (scanner/trades/MT5 sync still work without it).
ANTHROPIC_API_KEY=

# Shared secret the MT5 Expert Advisor must send with every request, so random
# people can't pretend to be your EA. Put the same value in the EA's inputs.
EA_SHARED_SECRET=change-me-too

# WebAuthn (Face ID / fingerprint) settings. WEBAUTHN_RP_ID must be the bare
# domain your backend AND app are considered part of (no https://, no port) —
# e.g. "myapp.example.com". For local testing, "localhost" is fine.
# WEBAUTHN_ORIGIN is the full origin the app is served from, e.g.
# "https://myapp.example.com". For an Android TWA/APK using Digital Asset
# Links, this is your https origin, not an android:// URI — see README.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# Comma-separated list of symbols the scanner/quotes service will track by default.
DEFAULT_SYMBOLS=XAU/USD,EUR/USD,GBP/USD,USD/JPY
